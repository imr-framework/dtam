# Copy to .env and fill in secrets locally. Never commit real credentials.

# Google / Gemini credentials are typically provided via GOOGLE_API_KEY or
# ADC. This project does not hard-code API keys.

# Digital twin runtime configuration (non-secret)
DT_MODEL=gemini-2.5-flash
DT_DEFAULT_MODE=observe
DT_LOG_LEVEL=INFO
DT_MAX_WORKFLOW_ITERATIONS=3
DT_MAX_SPECIALIST_RETRIES=1
DT_MIN_ACTION_CONFIDENCE=0.55
DT_ENABLE_SIMULATED_ACT_MODE=false
DT_TOOL_TIMEOUT_S=10
DT_MAX_EMI_SAMPLES=50000
DT_MAX_PARALLEL_WORKERS=4
